{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/ai/health", "destination": "/api/ai/health" },
    { "source": "/api/ai/openai/chat", "destination": "/api/ai/openai/chat" },
    { "source": "/api/ai/google/chat", "destination": "/api/ai/google/chat" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "functions": {
    "api/ai/openai/chat.js": { "maxDuration": 30 },
    "api/ai/google/chat.js": { "maxDuration": 30 },
    "api/ai/health.js": { "maxDuration": 5 }
  }
}
